# Copy to deploy/.env (git-ignored, mode 0600). Compose hands this file to the engine and the console.
# deploy/first-run.sh fills every empty value it can (deploy/README.md#first-run).

# ---- images -------------------------------------------------------------------------------------
# Registry prefix for the images scripts/build-images.sh builds; empty keeps local-only names.
IMAGE_REGISTRY=
ENGINE_PORT=8090                             # 127.0.0.1 only: Swagger at /docs is the stack's write path
CONSOLE_PORT=3060                            # 127.0.0.1 only: pages need no sign-in; writes need a key (D16)

# ---- livepeer-builder engine (stock `lpb serve`, per_actor mode) ----------------------------------
# The same LPB_* variables and values ChatLPT uses, minus its per_application shared key.
LPB_ENGINE_ID=builder-console
LPB_ALLOCATION_MODE=per_actor
LPB_SIGNER_URL=http://clearinghouse:8937     # the signer shares the clearinghouse network namespace
LPB_BATTERIES_URL=http://clearinghouse:8081
LPB_BATTERIES_TOKEN=                         # deploy/secrets/engine-token
LPB_BATTERIES_OPERATOR_TOKEN=                # deploy/secrets/grant-desk-token
LPB_SECRET_KEY=                              # lpb gen-secret-key (Fernet key for the engine's secret store)
LPB_DEFAULT_CURRENCY=USD
LPB_LOG_JSON=true

# ---- console ------------------------------------------------------------------------------------
CONSOLE_ENGINE_ADMIN_TOKEN=                  # lpk_ admin key from `lpb bootstrap-admin` (first-run.sh)
CONSOLE_BATTERIES_TOKEN=                     # deploy/secrets/console-reader-token: Batteries *.read only
CONSOLE_APPLICATION_ID=default               # the engine application the admin key reads (docs/references/gaps.md#g9)
CONSOLE_CACHE_TTL_S=15                       # how long one read of each source is reused
CONSOLE_SESSION_SECRET=                      # seals Operator and Builder sign-ins (D16); first-run.sh writes one
